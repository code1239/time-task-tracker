# Database - App (restricted user, used by the running app)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=time_task_tracker
DB_USER=ttt_app
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Database - Admin (ONLY used by db:setup script, never by app, never passed to Docker)
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=

# Auth
JWT_SECRET=
COOKIE_SECURE=false

# Note: In Docker, set DB_SERVER=host.docker.internal. For local dev, DB_SERVER=localhost.
