# Database - App (restricted user, used by the running app)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=time_task_tracker
DB_USER=ttt_app
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Database - Admin (ONLY used by db:setup script, never by app, never passed to Docker)
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=

# Auth
JWT_SECRET=
COOKIE_SECURE=false

# Note: In Docker, set DB_SERVER=host.docker.internal. For local dev, DB_SERVER=localhost.

# Notion (optional) - "Notion ile Bağlan" in the Notion tab
# Create a *public* integration at https://www.notion.so/profile/integrations (read content only)
# and set its redirect URI to NOTION_REDIRECT_URI.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback
# Optional: key used to encrypt stored Notion tokens (defaults to a key derived from JWT_SECRET)
NOTION_TOKEN_KEY=
